# Copy this file to .env (same folder) and fill in your key.
# Never commit .env. It is already in .gitignore.

# Claude API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Model used for the second-opinion judgements.
# claude-sonnet-5-5 is the default. claude-haiku-5-5 is cheaper and faster.
SIFT_CLAUDE_MODEL=claude-sonnet-5-5

# How hard Claude thinks before answering: low | medium | high
# low keeps each judgement to a few seconds, which suits a live demo.
SIFT_CLAUDE_EFFORT=low

# Django
DJANGO_SECRET_KEY=change-me-to-any-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
